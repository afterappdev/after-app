generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  VENUE
  ADMIN
}

enum PhotoKind {
  GALLERY
  MENU
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum BannerStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

model User {
  id                String                   @id @default(cuid())
  name              String
  email             String                   @unique
  passwordHash      String
  googleId          String?                  @unique
  appleId           String?                  @unique
  role              Role                     @default(USER)
  state             String
  city              String
  avatarUrl         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  venue             Venue?
  favorites         Favorite[]
  reviews           Review[]
  notifications     Notification[]
  deletionRequests  AccountDeletionRequest[]
  passwordResets    PasswordResetRequest[]
  adminDeviceTokens AdminDeviceToken[]

  @@index([role, createdAt])
}

enum AdminPushEventType {
  ACCOUNT_CREATED
  VENUE_CREATED
  PURCHASE_PAID
}

/// FCM registration tokens for After Admin devices. Not used by the consumer app.
model AdminDeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Idempotency outbox for administrative FCM. Unique per logical event.
model AdminPushEvent {
  id        String             @id @default(cuid())
  type      AdminPushEventType
  entityId  String
  createdAt DateTime           @default(now())
  sentAt    DateTime?
  error     String?

  @@unique([type, entityId])
  @@index([createdAt])
}

/// Temporary Google/Apple identity before the user picks USER vs VENUE.
/// Not a session. Single-use; the signed onboarding JWT references `id` as `jti`.
model SocialOnboardingToken {
  id         String    @id @default(cuid())
  provider   String
  providerId String
  email      String
  name       String
  avatarUrl  String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([provider, providerId])
  @@index([expiresAt])
}

model PasswordResetRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AccountDeletionRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Venue {
  id            String           @id @default(cuid())
  ownerUserId   String           @unique
  owner         User             @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  category      String?
  logoUrl       String?
  coverUrl      String?
  city          String
  state         String
  lat           Float?
  lng           Float?
  contacts      Json?
  /// Weekly hours JSON, e.g. { "mon": { "open": "10:00", "close": "22:00" }, ... }
  hoursJson     Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  photos        VenuePhoto[]
  favorites     Favorite[]
  reviews       Review[]
  wallet        CreditWallet?
  purchases     CreditPurchase[]
  banners       Banner[]
  notifications Notification[]
}

model VenuePhoto {
  id        String    @id @default(cuid())
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url       String
  kind      PhotoKind @default(GALLERY)
  mediaType MediaType @default(IMAGE)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([venueId, kind])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  venueId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, venueId])
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  venueId     String
  rating      Int
  testimonial String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue       Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId, createdAt])
}

model CreditWallet {
  venueId   String   @id
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model CreditPurchase {
  id           String         @id @default(cuid())
  venueId      String
  venue        Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  packageKey   String
  productId    String?
  amountPaid   Decimal        @db.Decimal(10, 2)
  currency     String         @default("BRL")
  credits      Int
  provider     String?
  providerTxId String?        @unique
  status       PurchaseStatus @default(PENDING)
  confirmedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([venueId, createdAt])
  @@index([status, confirmedAt])
  @@index([provider, status, confirmedAt])
}

model Banner {
  id            String           @id @default(cuid())
  venueId       String
  venue         Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  imageUrl      String
  title         String?
  description   String?
  creditsCost   Int
  status        BannerStatus     @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  schedules     BannerSchedule[]
  notifications Notification[]

  @@index([venueId, createdAt])
}

model BannerSchedule {
  id           String   @id @default(cuid())
  bannerId     String
  banner       Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  displayDate  DateTime @db.Date
  citySnapshot String

  @@index([citySnapshot, displayDate])
  @@index([bannerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bannerId  String?
  banner    Banner?   @relation(fields: [bannerId], references: [id], onDelete: SetNull)
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}
