generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  VENUE
  ADMIN
}

enum PhotoKind {
  GALLERY
  MENU
}

enum MediaType {
  IMAGE
  VIDEO
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

/// Fiscal identity of a venue. Null on accounts created before the field existed.
enum VenueDocumentType {
  CPF
  CNPJ
}

/// SIGNUP is a new grant of 1 common credit.
/// HISTORICAL records a welcome purchase that already happened, often 2 credits,
/// and does not move any balance.
enum WelcomeCreditSource {
  SIGNUP
  HISTORICAL
}

/// Self-reported age band. It is not proof of majority and does not grant access.
enum AgeBand {
  AGE_0_18
  AGE_19_35
  AGE_36_50
  AGE_OVER_50
}

enum BannerStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

/// Optional explicit kind. Null means the publication was not classified.
enum BannerContentKind {
  PROMOTION
  EVENT
}

enum PromoPushEventStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum PromoPushDeliveryStatus {
  CLAIMED
  SENT
  FAILED
  INVALID
  SKIPPED
}

/// Consumer account lifecycle. PENDING_DELETION keeps data for the recovery window.
enum AccountLifecycleStatus {
  ACTIVE
  PENDING_DELETION
  /// Personal data removed; row may remain when financial retention requires venue/purchase FKs.
  PURGED
}

/// Outbox for the eventual hard-delete worker. No FK to User so completed rows
/// can retain the user id for audit after the account row is removed.
enum AccountPurgeJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model User {
  id                String                   @id @default(cuid())
  name              String
  email             String                   @unique
  passwordHash      String
  googleId          String?                  @unique
  appleId           String?                  @unique
  /// AES-256-GCM ciphertext of the Apple refresh token. Never log or return.
  appleRefreshTokenEnc String?
  /// client_id used to issue the refresh token (Bundle ID or Services ID).
  appleClientId     String?
  role              Role                     @default(USER)
  state             String
  city              String
  avatarUrl         String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  /// Venues owned by this account (VENUE role). A user may own many venues.
  ownedVenues       Venue[]                  @relation("VenueOwner")
  /// Selected venue for implicit API routes (credits, banners, etc.).
  activeVenueId     String?
  activeVenue       Venue?                   @relation("UserActiveVenue", fields: [activeVenueId], references: [id], onDelete: SetNull)
  favorites         Favorite[]
  reviews           Review[]
  notifications     Notification[]
  deletionRequests  AccountDeletionRequest[]
  passwordResets    PasswordResetRequest[]
  adminDeviceTokens AdminDeviceToken[]
  venueBlocks              UserVenueBlock[]
  reportsFiled             Report[]             @relation("ReportReporter")
  reportsReviewed          Report[]             @relation("ReportReviewer")
  reportsContentRestored   Report[]             @relation("ReportContentRestorer")
  creditCouponsCreated     CreditCoupon[]       @relation("CreditCouponCreator")
  /// IBGE municipality id of the registered city. Null when name+UF is ambiguous.
  ibgeCityId                Int?
  /// Product consent for promotional pushes. Independent of the OS permission.
  promoNotificationsEnabled Boolean              @default(false)
  /// Null on accounts created before the field existed. Not used for ads or pushes.
  ageBand                   AgeBand?
  lastAuthorizedIbgeCityId  Int?
  lastAuthorizedCityAt      DateTime?
  devicePushTokens          DevicePushToken[]
  promoPushDeliveries       PromoPushDelivery[]
  /// ACTIVE by default for existing rows. PENDING_DELETION is set when the owner
  /// schedules deletion; behavior is wired in later phases.
  accountStatus             AccountLifecycleStatus @default(ACTIVE)
  deletionRequestedAt       DateTime?
  permanentDeletionAt       DateTime?
  deletionConfirmedAt       DateTime?
  deletionCancelledAt       DateTime?
  /// JWTs issued before this instant should be rejected once session checks ship.
  sessionInvalidatedAt      DateTime?
  /// Bumped when global session invalidation occurs; normal JWTs carry claim sv.
  sessionVersion            Int                      @default(0)

  @@index([role, createdAt])
  @@index([ibgeCityId])
  @@index([promoNotificationsEnabled, ibgeCityId])
  @@index([lastAuthorizedIbgeCityId, lastAuthorizedCityAt])
  @@index([activeVenueId])
  @@index([accountStatus, permanentDeletionAt])
}

enum AdminPushEventType {
  ACCOUNT_CREATED
  VENUE_CREATED
  PURCHASE_PAID
  REPORT_CREATED
  COUPON_REDEEMED
}

/// FCM registration tokens for After Admin devices. Not used by the consumer app.
model AdminDeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// Idempotency outbox for administrative FCM. Unique per logical event.
model AdminPushEvent {
  id        String             @id @default(cuid())
  type      AdminPushEventType
  entityId  String
  createdAt DateTime           @default(now())
  sentAt    DateTime?
  error     String?

  @@unique([type, entityId])
  @@index([createdAt])
}

/// Temporary Google/Apple identity before the user picks USER vs VENUE.
/// Not a session. Single-use; the signed onboarding JWT references `id` as `jti`.
model SocialOnboardingToken {
  id         String    @id @default(cuid())
  provider   String
  providerId String
  email      String
  name       String
  avatarUrl  String?
  appleRefreshTokenEnc String?
  appleClientId        String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([provider, providerId])
  @@index([expiresAt])
}

model PasswordResetRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AccountDeletionRequest {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One row per scheduled hard delete. userId is unique while a purge is in flight.
/// CANCELLED when the owner recovers the account. COMPLETED/FAILED keep userId
/// without a User FK so audit survives the final delete.
model AccountPurgeJob {
  id            String                @id @default(cuid())
  userId        String                @unique
  scheduledFor  DateTime
  status        AccountPurgeJobStatus @default(PENDING)
  attempts      Int                   @default(0)
  lastError     String?
  completedAt   DateTime?
  cancelledAt   DateTime?
  lockedUntil   DateTime?
  lockedBy      String?
  /// Incremented on each claim; workers must match to mutate a PROCESSING job.
  leaseEpoch    Int                   @default(0)
  /// ELIGIBILITY | FINANCIAL | MANIFEST | DATA | UPLOADS | DONE
  progressStage String?
  uploadManifest Json?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([status, scheduledFor])
  @@index([status, scheduledFor, lockedUntil])
}

model Venue {
  id            String           @id @default(cuid())
  ownerUserId   String
  owner         User             @relation("VenueOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  usersActive   User[]           @relation("UserActiveVenue")
  name          String
  description   String?
  category      String?
  logoUrl       String?
  coverUrl      String?
  city          String
  state         String
  /// IBGE municipality id. Null when the stored name and UF do not resolve uniquely.
  ibgeCityId    Int?
  /// CPF or CNPJ. Null until an older venue informs it. Stored as digits only.
  documentType   VenueDocumentType?
  documentDigits String?
  lat           Float?
  lng           Float?
  contacts      Json?
  /// Weekly hours JSON, e.g. { "mon": { "open": "10:00", "close": "22:00" }, ... }
  hoursJson     Json?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  photos        VenuePhoto[]
  favorites     Favorite[]
  reviews       Review[]
  wallet        CreditWallet?
  purchases     CreditPurchase[]
  refundAudits  CreditRefundAudit[]
  banners             Banner[]
  bannerPublicationIdempotencies BannerPublicationIdempotency[]
  notifications       Notification[]
  blockedByUsers      UserVenueBlock[]
  moderationHiddenAt  DateTime?
  /// Owner-initiated closure; row and financial history are kept.
  ownerArchivedAt     DateTime?
  couponRedemptions   CreditCouponRedemption[]
  creditObligations   CreditObligation[]
  creditLedgerEntries CreditLedgerEntry[]
  vipCreditEntries    VipCreditEntry[]
  welcomeCreditVenueProvision WelcomeCreditVenueProvision?

  @@index([ownerUserId])
  @@index([documentType, documentDigits])
  @@index([moderationHiddenAt])
  @@index([ownerArchivedAt])
  @@index([ibgeCityId])
}

model VenuePhoto {
  id        String    @id @default(cuid())
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  url       String
  kind      PhotoKind @default(GALLERY)
  mediaType MediaType @default(IMAGE)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([venueId, kind])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  venueId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, venueId])
}

model Review {
  id           String    @id @default(cuid())
  userId       String
  venueId      String
  rating       Int
  testimonial  String?
  venueReply   String?
  venueReplyAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue        Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@unique([userId, venueId])
  @@index([venueId, createdAt])
}

model CreditWallet {
  venueId    String   @id
  venue      Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  balance    Int      @default(0)
  /// VIP credits. Separate from balance. Existing rows start at 0.
  vipBalance Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// Proof that a CPF or CNPJ already received the one-time welcome credit.
/// documentKey is HMAC-SHA256 of `v1:{CPF|CNPJ}:{digits}` using
/// WELCOME_CREDIT_HMAC_SECRET. The document itself is not stored.
/// originVenueId is a historical id with no foreign key: deleting the venue
/// or the account must not erase this proof and must not be blocked by it.
///
/// Purpose: stop a second welcome grant for the same document.
/// Period: while the welcome benefit exists. A calendar expiry would reopen it.
/// Basis: LGPD art. 7, IX and art. 10 (legitimate interest in preventing
/// repeated benefit fraud). The row is the digest, the type, the quantity,
/// the grant time and the origin venue id. Other personal data still follows
/// account deletion. Do not rotate the secret or the `v1` prefix: old digests
/// would miss and the same document could receive the benefit again.
/// HISTORICAL rows copy the welcome purchase quantity. They do not grant credit.
/// A deleted account that left no welcome purchase and no claim cannot be linked.
model WelcomeCreditClaim {
  id             String               @id
  documentKey    String               @unique
  documentType   VenueDocumentType
  /// SIGNUP is always 1. HISTORICAL keeps the purchase quantity, including 2.
  creditsGranted Int
  source         WelcomeCreditSource  @default(SIGNUP)
  grantedAt      DateTime             @default(now())
  originVenueId  String?
}

/// Venue received welcome credit before a fiscal document existed.
/// One row per venue. Does not replace document-based proof after linking.
model WelcomeCreditVenueProvision {
  venueId        String   @id
  venue          Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  creditsGranted Int
  grantedAt      DateTime @default(now())
}

/// Append-only VIP movement. operationKey is the idempotency identity.
/// A consume row is the persisted proof that a VIP day was paid.
model VipCreditEntry {
  id           String           @id @default(cuid())
  venueId      String
  venue        Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  operationKey String           @unique
  /// grant, consume, or refund.
  kind         String
  credits      Int
  balanceDelta Int
  bannerId     String?
  scheduleId   String?          @unique
  createdAt    DateTime         @default(now())
  schedule     BannerSchedule?

  @@index([venueId, createdAt])
}

model CreditPurchase {
  id                String         @id @default(cuid())
  venueId           String
  venue             Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  packageKey        String
  productId         String?
  amountPaid        Decimal        @db.Decimal(10, 2)
  currency          String         @default("BRL")
  credits           Int
  provider          String?
  providerTxId      String?        @unique
  status            PurchaseStatus @default(PENDING)
  confirmedAt       DateTime?
  invoiceRequested  Boolean        @default(false)
  fiscalPersonType  String?
  fiscalName        String?
  fiscalDocument    String?
  fiscalEmail       String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  refundAudits        CreditRefundAudit[]
  creditObligation    CreditObligation?
  creditLedgerEntries CreditLedgerEntry[]

  @@unique([id, venueId])
  @@index([venueId, createdAt])
  @@index([status, confirmedAt])
  @@index([provider, status, confirmedAt])
}

/// One row per purchase and kind. Duplicate webhooks do not insert again.
model CreditRefundAudit {
  id                 String         @id @default(cuid())
  purchaseId         String
  purchase           CreditPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  venueId            String
  venue              Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  /// shortfall: credits not recovered on a full refund.
  /// partial_review: latest proven partial sum for this purchase. It only increases.
  /// refund_review: unproven refund signal. It stays after a later proof and is not a debit.
  kind               String
  creditsRecovered   Int?
  creditsUnrecovered Int?
  originalAmount     Decimal?       @db.Decimal(10, 2)
  refundedAmount     Decimal?       @db.Decimal(10, 2)
  refundId           String?
  createdAt          DateTime       @default(now())

  @@unique([purchaseId, kind])
  @@index([venueId, createdAt])
}

/// One debt per refunded purchase. Unused until a later phase writes it.
/// The purchase relation includes venueId, so the debt cannot point at another venue.
/// Venue and purchase deletes are restricted so the row is not cascaded away.
/// Cross-field checks live in the migration; Prisma 5 cannot express them here.
model CreditObligation {
  id               String         @id @default(cuid())
  venueId          String
  venue            Venue          @relation(fields: [venueId], references: [id], onDelete: Restrict)
  purchaseId       String         @unique
  purchase         CreditPurchase @relation(fields: [purchaseId, venueId], references: [id, venueId], onDelete: Restrict)
  creditsOriginal  Int
  creditsRecovered Int
  creditsOpened    Int
  creditsSettled   Int            @default(0)
  /// open while creditsSettled < creditsOpened; settled when they are equal.
  status           String
  /// pix_full_refund or card_full_refund.
  source           String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  ledgerEntries    CreditLedgerEntry[]

  @@unique([purchaseId, venueId])
  @@unique([id, venueId])
  @@index([venueId, status, createdAt])
}

/// Append-only credit movement. operationKey is the idempotency identity.
/// Optional links use Restrict. A composite delete action that nulls every
/// foreign-key column would clear venueId, and Prisma 5.22 cannot null only the optional id.
/// No service writes this table yet.
model CreditLedgerEntry {
  id             String                  @id @default(cuid())
  venueId        String
  venue          Venue                   @relation(fields: [venueId], references: [id], onDelete: Restrict)
  operationKey   String                  @unique
  kind           String
  purchaseId     String?
  purchase       CreditPurchase?         @relation(fields: [purchaseId, venueId], references: [id, venueId], onDelete: Restrict)
  obligationId   String?
  obligation     CreditObligation?       @relation(fields: [obligationId, venueId], references: [id, venueId], onDelete: Restrict)
  redemptionId   String?
  redemption     CreditCouponRedemption? @relation(fields: [redemptionId, venueId], references: [id, venueId], onDelete: Restrict)
  bannerId       String?
  banner         Banner?                 @relation(fields: [bannerId, venueId], references: [id, venueId], onDelete: Restrict)
  credits        Int
  availableDelta Int
  debtDelta      Int
  createdAt      DateTime                @default(now())

  @@index([venueId, createdAt])
}

/// Single lease row so paid-card reconciliation cannot run twice at once.
/// The cursor remembers the last concluded attempt so the next run continues
/// after it. Null means the next run starts at the oldest eligible purchase.
/// cooldownUntil pauses new Orders API calls after HTTP 429. It is not the lease.
model CardReconcileLock {
  id                 Int       @id
  lockedUntil        DateTime
  lockedBy           String
  cursorConfirmedAt  DateTime?
  cursorPurchaseId   String?
  cooldownUntil      DateTime?
}

enum CouponCreditKind {
  COMMON
  VIP
}

/// Bonus credits granted by an admin code. Not a store discount.
model CreditCoupon {
  id                     String                   @id @default(cuid())
  /// Stored trimmed and uppercased. Unique regardless of client casing.
  code                   String                   @unique
  creditAmount           Int
  /// COMMON credits go to CreditWallet.balance; VIP credits go to vipBalance.
  creditKind             CouponCreditKind         @default(COMMON)
  active                 Boolean                  @default(true)
  startsAt               DateTime?
  expiresAt              DateTime?
  maxRedemptions         Int?
  maxRedemptionsPerVenue Int                      @default(1)
  createdById            String?
  createdBy              User?                    @relation("CreditCouponCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  redemptions            CreditCouponRedemption[]

  @@index([active, expiresAt])
}

model CreditCouponRedemption {
  id           String       @id @default(cuid())
  couponId     String
  coupon       CreditCoupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  /// Null after the venue account is deleted. The snapshot columns keep the audit trail.
  venueId      String?
  venue        Venue?       @relation(fields: [venueId], references: [id], onDelete: SetNull)
  /// Public establishment name at redemption. Not the owner's personal data.
  venueNameSnapshot String
  /// Public city at redemption.
  venueCitySnapshot String?
  creditAmount Int
  /// Snapshot of the coupon kind at redemption time.
  creditKind   CouponCreditKind @default(COMMON)
  redeemedAt   DateTime     @default(now())
  ledgerEntries CreditLedgerEntry[]

  @@unique([id, venueId])
  @@index([couponId, redeemedAt])
  @@index([venueId, redeemedAt])
  @@index([couponId, venueId])
}

model Banner {
  id            String           @id @default(cuid())
  venueId       String
  venue         Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  imageUrl      String
  title         String?
  description   String?
  creditsCost    Int
  vipCreditsCost Int             @default(0)
  status        BannerStatus     @default(ACTIVE)
  /// Null on every publication created before an explicit kind existed.
  contentKind   BannerContentKind?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  schedules     BannerSchedule[]
  notifications Notification[]
  ledgerEntries CreditLedgerEntry[]
  publicationIdempotencies BannerPublicationIdempotency[]

  @@unique([id, venueId])
  @@index([venueId, createdAt])
}

enum BannerPublicationIdempotencyStatus {
  PROCESSING
  COMPLETED
}

/// One logical POST /banners attempt per venue + client key. Prevents duplicate debits.
model BannerPublicationIdempotency {
  id             String                             @id @default(cuid())
  venueId        String
  venue          Venue                              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  idempotencyKey String
  requestHash    String
  status         BannerPublicationIdempotencyStatus @default(PROCESSING)
  bannerId       String?
  banner         Banner?                            @relation(fields: [bannerId], references: [id], onDelete: SetNull)
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt

  @@unique([venueId, idempotencyKey])
  @@index([bannerId])
}

model BannerSchedule {
  id           String   @id @default(cuid())
  bannerId     String
  banner       Banner   @relation(fields: [bannerId], references: [id], onDelete: Cascade)
  displayDate      DateTime         @db.Date
  citySnapshot     String
  ibgeCityId       Int?
  /// Existing rows stay common. VIP requires a persisted credit proof.
  tier             PublicationTier  @default(COMMON)
  /// Horário escolhido do aviso push VIP. Null em publicações antigas ou dias comuns.
  vipPushTiming    VipPushTiming?
  vipCreditEntryId String?          @unique
  vipCreditEntry   VipCreditEntry?  @relation(fields: [vipCreditEntryId], references: [id], onDelete: SetNull)
  promoPushEvents  PromoPushEvent[]

  @@index([citySnapshot, displayDate])
  @@index([bannerId])
  @@index([ibgeCityId, displayDate])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bannerId  String?
  banner    Banner?   @relation(fields: [bannerId], references: [id], onDelete: SetNull)
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

enum ReportTargetType {
  VENUE
  BANNER
  PHOTO
  VIDEO
  REVIEW
}

enum ReportReason {
  INAPPROPRIATE
  SPAM
  MISLEADING
  VIOLENCE
  SEXUAL
  HATE
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED
  REJECTED
}

enum ReportModerationAction {
  NONE
  CONTENT_REMOVED
  VENUE_HIDDEN
}

/// User-generated content report. Target is identified by type + id (no FK)
/// so the row survives if the original content is later deleted.
model Report {
  id                String                 @id @default(cuid())
  reporterId        String?
  reporter          User?                  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  targetType        ReportTargetType
  targetId          String
  reason            ReportReason
  description       String?
  status            ReportStatus           @default(PENDING)
  targetSnapshot    Json?
  moderationAction  ReportModerationAction @default(NONE)
  adminNote         String?
  reviewedById         String?
  reviewedBy           User?                  @relation("ReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolvedAt           DateTime?
  /// Audit of an admin restoring a moderation-hidden VENUE. Does not change status.
  contentRestoredAt    DateTime?
  contentRestoredById  String?
  contentRestoredBy    User?                  @relation("ReportContentRestorer", fields: [contentRestoredById], references: [id], onDelete: SetNull)
  /// Set while PENDING/REVIEWING to enforce one active report per user+target.
  activeKey            String?                @unique
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId, createdAt])
}

/// Consumer FCM token. Not an admin token. Logout disables the row; it is not deleted.
model DevicePushToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  platform   String
  disabledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, disabledAt])
}

/// One row per VIP schedule slot. Common schedules no longer create rows.
model PromoPushEvent {
  id               String               @id @default(cuid())
  bannerScheduleId String
  slot             Int                  @default(1)
  bannerSchedule   BannerSchedule       @relation(fields: [bannerScheduleId], references: [id], onDelete: Cascade)
  bannerId         String
  venueId          String
  ibgeCityId       Int
  displayDate      DateTime             @db.Date
  contentKind      BannerContentKind?
  status           PromoPushEventStatus @default(PENDING)
  availableAt      DateTime
  expiresAt        DateTime
  lockedUntil      DateTime?
  lockedBy         String?
  attempts         Int                  @default(0)
  sentAt           DateTime?
  error            String?
  targetedUsers    Int                  @default(0)
  targetedTokens   Int                  @default(0)
  sentCount        Int                  @default(0)
  failedCount      Int                  @default(0)
  skippedCount     Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  deliveries       PromoPushDelivery[]

  @@unique([bannerScheduleId, slot])
  @@index([status, availableAt])
  @@index([expiresAt, status])
  @@index([bannerId, status])
}

enum PublicationTier {
  COMMON
  VIP
}

enum VipPushTiming {
  IMMEDIATE
  SLOT_11
  SLOT_17
}

/// One attempt row per event and device. tokenId is not a foreign key so disabling a token keeps the cap history.
model PromoPushDelivery {
  id        String                  @id @default(cuid())
  eventId   String
  event     PromoPushEvent          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tokenId   String
  userId    String
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    PromoPushDeliveryStatus
  attempts  Int                     @default(0)
  error     String?
  sentAt    DateTime?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt

  @@unique([eventId, tokenId])
  @@index([userId, status, sentAt])
  @@index([eventId, status])
}

/// Lease so only one API instance dispatches promotional pushes at a time.
model PromoPushWorkerLock {
  id          Int      @id
  lockedUntil DateTime
  lockedBy    String
}

model UserVenueBlock {
  id        String   @id @default(cuid())
  userId    String
  venueId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, venueId])
  @@index([venueId])
}
