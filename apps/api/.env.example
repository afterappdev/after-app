# Railway injeta PORT automaticamente. Em local, use 3000.
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://after:after@localhost:5433/after?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
# HMAC-SHA256 do benefício de boas-vindas por CPF/CNPJ. Segredo exclusivo desta regra.
# O mesmo valor em todas as instâncias da API. Não rotacionar e não alterar o prefixo v1:
# a troca faz um documento já beneficiado parecer novo e permite um segundo crédito.
# Mínimo de 32 caracteres. Sem este valor, o cadastro de estabelecimento é recusado.
# O cadastro de usuário comum não usa este segredo. Não reutilizar JWT_SECRET nem o
# segredo de webhook do Mercado Pago. Não versionar o valor real. Não há padrão de produção.
# PowerShell:
#   $bytes = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
WELCOME_CREDIT_HMAC_SECRET=
# Business rule (adjust later): 1 credit = 1 day of banner display
CREDIT_PER_DISPLAY_DAY=1

# Conta administrativa (opcional no seed). Nunca commitar senha real.
# Se ambos estiverem vazios, o seed ignora a criação do ADMIN.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Firebase Cloud Messaging — somente After Admin (nunca no app consumidor).
# JSON da service account do Firebase Admin SDK (uma linha). Private key com \n escapado.
# Sem este valor a API sobe normalmente e não envia push (warning no log).
# Nunca versionar a credencial real.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Store billing (Android Google Play / iOS App Store)
GOOGLE_PLAY_PACKAGE_NAME="com.r2p.after.after_app"
# JSON da service account com acesso à Google Play Developer API (arquivo ou JSON inline)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_BUNDLE_ID="com.r2p.after.afterApp"
# Segredo compartilhado do app (App Store Connect > App > Informações gerais > Segredo compartilhado).
# Usado só para recibos PKCS#7 legados em verifyReceipt. Compras atuais do app (StoreKit 2 / TestFlight)
# enviam um JWS e não dependem deste segredo.
APPLE_SHARED_SECRET=
# Apple ID numérico do app (App Store Connect > App > Informações gerais > Apple ID). Não é o bundle ID.
# Obrigatório para validar compras de Production. TestFlight usa Sandbox e não exige este valor.
# A validação JWS usa os certificados raiz da Apple embutidos na API e consulta OCSP (ocsp.apple.com).
# Nenhuma chave .p8 nova é necessária para confirmar a compra.
APPLE_APP_APPLE_ID=

# Sign in with Apple (Web). Nunca versionar a chave .p8.
# APPLE_PRIVATE_KEY aceita PEM multilinha ou com \n literal.
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# AES-256-GCM para refresh tokens Apple em repouso. Independente de JWT_SECRET.
# Formato: exatamente 32 bytes aleatórios, em Base64 padrão (com padding).
# Obrigatória quando APPLE_TEAM_ID + APPLE_KEY_ID + APPLE_PRIVATE_KEY estiverem definidos.
# Gerar no PowerShell (não versionar o valor real):
#   $bytes = New-Object byte[] 32
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($bytes)
#   [Convert]::ToBase64String($bytes)
APPLE_TOKEN_ENCRYPTION_KEY=

# PIX e cartão via Mercado Pago Orders (Access Token somente no backend).
# No Checkout API Orders, o Access Token de teste começa com APP_USR-, o mesmo prefixo do token de produção.
# A Public Key em Credenciais de teste também pode começar com APP_USR-. Esse prefixo não identifica produção.
# TEST- é um prefixo antigo de credencial de teste e é recusado quando NODE_ENV=production.
# Copie o par em Testes > Credenciais de teste. Não use o par de Produção > Credenciais de produção nos testes.
# Sandbox local: MERCADO_PAGO_SANDBOX=true com NODE_ENV diferente de production.
# Produção: MERCADO_PAGO_SANDBOX=false. NODE_ENV=production recusa Sandbox e credencial TEST-.
# A consulta de orders já criadas não usa esta trava. Nunca commitar os valores.
# Teste local de cartão: preencha apps/api/.env.card-test (gitignored) e use npm run start:card-test.
# Esse comando carrega o par de teste por cima deste arquivo. Não copie credenciais para cá.
MERCADO_PAGO_ACCESS_TOKEN=
# Chave pública do Card Payment Brick. Pode ser lida pelo After Web. Não é o Access Token.
MERCADO_PAGO_PUBLIC_KEY=
# true somente fora de production, com o par copiado de Credenciais de teste.
# Nunca true com NODE_ENV=production.
MERCADO_PAGO_SANDBOX=false
# Segredo HMAC gerado em Your integrations → Webhooks (Orders).
# A API não cadastra esta URL no Mercado Pago. No modo de teste do painel, use a URL
# HTTPS do túnel atual terminando em /credits/webhooks/mercadopago e habilite o tópico Order.
# Um túnel trycloudflare muda de host a cada execução. npm run start:card-test -- --no-watch
# sobe a API sem reiniciar a cada arquivo salvo.
MERCADO_PAGO_WEBHOOK_SECRET=
# URL HTTPS pública para cadastrar no painel do Mercado Pago (não é enviada pela API).
# POST /credits/webhooks/pix permanece válido. POST /credits/webhooks/mercadopago é alias.
MERCADO_PAGO_WEBHOOK_URL="http://localhost:3000/credits/webhooks/mercadopago"
# Reconciliação periódica de estornos de cartão já pagos. Permanece desligada.
# Somente o valor exato true liga o intervalo de 15 minutos. Não roda no startup.
# Exige as colunas de cursor e cooldown em CardReconcileLock. Não cria cobrança.
CARD_REFUND_RECONCILE_ENABLED=false

# Login social (Google / Apple)
# Em produção, PUBLIC_API_URL e os redirects devem usar a URL HTTPS pública da API.
PUBLIC_API_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client IDs extras (Android / iOS) para validar idToken nativo
GOOGLE_CLIENT_IDS=
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
APPLE_REDIRECT_URI="http://localhost:3000/auth/apple/web/callback"
OAUTH_REDIRECT_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,https://app-after.com.br"
# Em produção no Railway: OAUTH_REDIRECT_ORIGINS=https://app-after.com.br
# (PUBLIC_APP_URL também entra na allowlist automaticamente.)

# App Web público (links de exclusão de conta — hash routing)
PUBLIC_APP_URL="http://localhost:8080"

# Resend HTTPS para e-mail de exclusão de conta (não usar SMTP no Railway).
# Copiar a API key do Resend para RESEND_API_KEY (a mesma que era SMTP_PASSWORD).
RESEND_API_KEY=
# Opcional; padrão: After <nao-responda@app-after.com.br>
RESEND_FROM="After <nao-responda@app-after.com.br>"

# Push promocional geolocalizado do app consumidor. Separado do FCM do After Admin.
# A service account continua sendo FIREBASE_SERVICE_ACCOUNT_JSON e não vai para o app.
# Publicação em massa só com o valor exato true e com a allowlist vazia.
# Allowlist preenchida restringe o envio àqueles ids, mesmo se a flag estiver true.
# Valor ausente, vazio ou diferente de true não envia ao público.
# Não existe curinga: um "*" é um id literal e não casa com ninguém.
PROMO_PUSH_ENABLED=false
PROMO_PUSH_ALLOWLIST_USER_IDS=
# Ausente usa 5. Valor inválido ou acima de 100 não envia.
PROMO_PUSH_MAX_PER_USER_PER_DAY=5
# Ausente usa 6. Valor inválido ou acima de 168 horas ignora a cidade detectada.
PROMO_PUSH_LOCATION_MAX_AGE_HOURS=6
# Horários dos dois disparos VIP, em America/Sao_Paulo. Ainda não aprovados.
# Vazio, inválido ou com mais de dois horários não agenda push.
# Formato: HH:MM,HH:MM. O estabelecimento não escolhe esses horários.
PROMO_PUSH_VIP_SLOT_TIMES=

# Cloudflare R2 (S3-compatible) — uploads de mídia
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="after-uploads"
R2_PUBLIC_URL="https://media.app-after.com.br"
