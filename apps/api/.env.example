# Railway injeta PORT automaticamente. Em local, use 3000.
PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://after:after@localhost:5433/after?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"
# Business rule (adjust later): 1 credit = 1 day of banner display
CREDIT_PER_DISPLAY_DAY=1

# Store billing (Android Google Play / iOS App Store)
GOOGLE_PLAY_PACKAGE_NAME="com.r2p.after.after_app"
# JSON da service account com acesso à Google Play Developer API (arquivo ou JSON inline)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_BUNDLE_ID="com.r2p.after.afterApp"
APPLE_SHARED_SECRET=

# PIX via Mercado Pago Orders / Checkout Transparente (somente backend)
# Use credenciais de TESTE (Access Token de teste). Nunca commitar o token.
MERCADO_PAGO_ACCESS_TOKEN=
# true somente em desenvolvimento/teste. Nunca true com NODE_ENV=production.
MERCADO_PAGO_SANDBOX=false
# Segredo HMAC gerado em Your integrations → Webhooks (Orders)
MERCADO_PAGO_WEBHOOK_SECRET=
# URL HTTPS pública para cadastrar no painel do Mercado Pago (não é enviada pela API)
MERCADO_PAGO_WEBHOOK_URL="http://localhost:3000/credits/webhooks/pix"

# Login social (Google / Apple)
# Em produção, PUBLIC_API_URL e os redirects devem usar a URL HTTPS pública da API.
PUBLIC_API_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Client IDs extras (Android / iOS) para validar idToken nativo
GOOGLE_CLIENT_IDS=
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
APPLE_SERVICE_ID=
APPLE_REDIRECT_URI="http://localhost:3000/auth/apple/callback"
OAUTH_REDIRECT_ORIGINS="http://localhost:8080,http://127.0.0.1:8080,https://app-after.com.br"
# Em produção no Railway: OAUTH_REDIRECT_ORIGINS=https://app-after.com.br
# (PUBLIC_APP_URL também entra na allowlist automaticamente.)

# App Web público (links de exclusão de conta — hash routing)
PUBLIC_APP_URL="http://localhost:8080"

# Resend HTTPS para e-mail de exclusão de conta (não usar SMTP no Railway).
# Copiar a API key do Resend para RESEND_API_KEY (a mesma que era SMTP_PASSWORD).
RESEND_API_KEY=
# Opcional; padrão: After <nao-responda@app-after.com.br>
RESEND_FROM="After <nao-responda@app-after.com.br>"
